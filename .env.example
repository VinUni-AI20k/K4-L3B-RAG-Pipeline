# Copy thành .env và chỉ điền provider nhóm sử dụng. Không commit secret thật.

# LLM: openai | gemini | anthropic
LLM_PROVIDER=openai
LLM_MODEL=

# Generation providers
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Task 4 embedding provider
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=8
# Keep one model/revision for both indexing and query embeddings.
EMBEDDING_REVISION=5617a9f61b028005a4858fdac845db406aefb181
CHROMA_COLLECTION=rag_documents
# Optional: use a drive with sufficient space for the model (~2.3 GB).
# EMBEDDING_MODEL_CACHE=D:/rag-model-cache
# EMBEDDING_CACHE_DIR=D:/rag-model-cache/task4-embeddings
# CHROMA_DB_PATH=D:/rag-model-cache/chroma_db

# Optional services
PAGEINDEX_API_KEY=
PAGEINDEX_API_BASE=https://api.pageindex.ai
PAGEINDEX_TIMEOUT=60
JINA_API_KEY=

# Hiệu chỉnh bằng query in-domain và out-of-domain trước khi điền.
SCORE_THRESHOLD=0.30
